{
  "exclude": [ "./src/cypress/*/**" ],
  "include": [
    "./src/**/*.ts",
    "./src/facies/*.vue",
    "./src/facies/tabulam/*.vue"
  ], "compileOnSave": true,
  "compilerOptions": {
    "allowArbitraryExtensions": true,
    "allowImportingTsExtensions": true,
    "allowJs": true,
    "allowSyntheticDefaultImports": true,
    "alwaysStrict": true,
    "assumeChangesOnlyAffectDirectDependencies": true,
    "extendedDiagnostics": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "importHelpers": true,
    "incremental": true,
    "lib": [ "dom" ],
    "module": "NodeNext",
    "moduleDetection": "auto",
    "moduleResolution": "NodeNext",
    "newLine": "lf",
    "noEmit": false,
    "noEmitOnError": true,
    "noErrorTruncation": true,
    "noImplicitAny": true,
    "noImplicitOverride": true,
    "noImplicitReturns": true,
    "noPropertyAccessFromIndexSignature": true,
    "noUnusedLocals": true,
    "outDir": "./dist/js",
    "removeComments": true,
    "rewriteRelativeImportExtensions": true,
    "rootDir": "./src",
    "paths": {
      "@res": [ "./res/*" ],
      "@/*": [ "./src/*" ],
      "@f3ve/vue-markdown-it": [ "./node_modules/@f3ve/vue-markdown-it/dist/vue-markdown-it.d.ts" ]
    }, "pretty": true,
    "skipLibCheck": true,
    "sourceMap": true,
    "target": "ESNext",
    "types": [
      "@types/node"
      // "node"
    ]
  }
}
