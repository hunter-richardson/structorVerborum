{
  "extends": "./tsconfig.debug.json",
  "compileOnSave": true,
  "compilerOptions": {
    "allowArbitraryExtensions": true,
    "allowImportingTsExtensions": true,
    "allowJs": true,
    "allowSyntheticDefaultImports": true,
    "alwaysStrict": true,
    "assumeChangesOnlyAffectDirectDependencies": true,
    "extendedDiagnostics": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "importHelpers": true,
    "incremental": true,
    "lib": [ "dom" ],
    "module": "esnext",
    "moduleDetection": "auto",
    "moduleResolution": "bundler",
    "newLine": "lf",
    "noEmit": false,
    "noEmitOnError": true,
    "noErrorTruncation": true,
    "noImplicitAny": true,
    "noImplicitOverride": true,
    "noImplicitReturns": true,
    "noPropertyAccessFromIndexSignature": true,
    "noUnusedLocals": true,
    "outDir": "./dist/js",
    "removeComments": true,
    "rewriteRelativeImportExtensions": true,
    "rootDir": "./src",
    "paths": {
      "@res": [ "./res/*" ],
      "@/*": [ "./src/*" ]
    }, "pretty": true,
    "skipLibCheck": true,
    "sourceMap": true,
    "target": "ES2023",
    "types": [
      "@types/node",
      "cypress",
      "cypress-map"
      // "node"
    ]
  }, "files": [],
  "include": [
    "./src/**/*.ts",
    "./src/facies/*.vue",
    "./src/facies/tabulam/*.vue"
  ], "exclude": [
    "./src/cypress/e2e/**",
    "./src/cypress/fixtures/*.json",
    "./src/cypress/support/*.ts"
  ]
}
