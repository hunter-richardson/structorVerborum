{
  "$schema": "https://typedoc.org/schema.json",
  "plugin": [
    "@mxssfd/typedoc-theme",
    "typedoc-plugin-markdown",
    "typedoc-github-wiki-theme",
    "@8hobbies/typedoc-plugin-404",
    "typedoc-plugin-vue",
    "typedoc-plugin-mdn-links"
  ],
  "theme": "dark",
  "includes": "src",
  "useCodeBlocks": true,
  "expandObjects": true,
  "expandParameters": true,
  "formatWithPrettier": true,
  "compilerOptions": {
    "alwaysStrict": true,
    "newLine": "lf"
  },
  "visibilityFilters": {
    "protected": false,
    "inherited": true,
    "external": false
  }
}
