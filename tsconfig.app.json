{
  "extends": "@vue/tsconfig/tsconfig.dom.json",
  "include": [
    "./env.d.ts",
    "./src/**/*.ts",
    "./src/facies/*.vue",
    "./src/facies/tabulam/*.vue",
    "./types/vue-shim.d.ts",
    "./src/figura.ts"
  ],
  "exclude": [
    "./src/cypress/**"
  ],
  "compilerOptions": {
    "composite": true,
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "paths": {
      "@/*": [
        "./src/*"
      ]
    }
  }
}
